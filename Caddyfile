:443 {
    tls internal {
        on_demand
    }

    request_body {
        max_size 1GB
    }

    handle_path /pdf/* {
        reverse_proxy 127.0.0.1:5001 {
            header_up X-Forwarded-Prefix /pdf
            header_up X-Forwarded-Proto https
        }
    }

    handle_path /mir/* {
        reverse_proxy 127.0.0.1:5002 {
            header_up X-Forwarded-Prefix /mir
            header_up X-Forwarded-Proto https
            flush_interval -1
        }
    }

    handle {
        root * /var/www/portal
        file_server
        try_files {path} /index.html
    }
}
